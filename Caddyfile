{
    # Global options
    admin off
}

:80 {
    # Serve static site
    root * /srv/current
    file_server
    header /rss.xml Content-Type "application/rss+xml; charset=utf-8"

    # Allow only specific API paths — everything else under /api returns 404
    handle /api/auth/* {
        reverse_proxy api:3000
    }

    handle /api/captcha/challenge {
        reverse_proxy api:3000
    }

    @comments {
        path /api/comments/*
        method GET POST
    }
    handle @comments {
        reverse_proxy api:3000
    }

    # Deny all other /api/* paths
    handle /api/* {
        respond 404
    }

    # SPA fallback for Nuxt
    handle {
        try_files {path} {path}/index.html /200.html
        file_server
    }

    # Encode responses
    encode zstd gzip
}
